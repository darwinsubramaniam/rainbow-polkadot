{
  "name": "rainbow-platformer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rainbow — a TEE-attested platformer, packaged as a Polkadot Product.",
  "scripts": {
    "sync-wasm": "node scripts/sync-wasm.mjs",
    "check-bundle": "node scripts/check-bundle.mjs",
    "dev": "npm run sync-wasm && vite",
    "build": "npm run sync-wasm && tsc -b && vite build && npm run check-bundle",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@parity/product-sdk": "*",
    "@parity/product-sdk-descriptors": "^0.8.0",
    "@parity/product-sdk-tx": "^0.3.2",
    "@xyflow/react": "^12.11.2",
    "pixi.js": "^8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
