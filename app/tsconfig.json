{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // TypeScript 5 pulled every `node_modules/@types` package in automatically,
    // which is how the `node:test` suites compiled without anyone saying so.
    // TypeScript 7 does not, and the tests stop resolving `node:assert`,
    // `node:test` and `import.meta.dirname`. Naming it restores exactly what
    // was implicit before — no more, and the `vite/client` reference in
    // `src/vite-env.d.ts` is a `///` directive, so it is unaffected.
    "types": ["node"],

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Node's type stripping resolves the specifier verbatim, so a test
    // importing the module under test must write `./attempts.ts`. Permitted
    // only because nothing here is emitted — Vite does its own resolution.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
