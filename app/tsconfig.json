{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Node's type stripping resolves the specifier verbatim, so a test
    // importing the module under test must write `./attempts.ts`. Permitted
    // only because nothing here is emitted — Vite does its own resolution.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
