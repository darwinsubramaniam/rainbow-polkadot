{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // TypeScript 5 pulled every `node_modules/@types` package in automatically,
    // which is how the `node:test` suites compiled without anyone saying so.
    // TypeScript 7 does not, and the tests stop resolving `node:assert`,
    // `node:test` and `import.meta.dirname`. Naming it restores exactly what
    // was implicit before — no more, and the `vite/client` reference in
    // `src/vite-env.d.ts` is a `///` directive, so it is unaffected.
    "types": ["node"],

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Node's type stripping resolves the specifier verbatim, so a test
    // importing the module under test must write `./attempts.ts`. Permitted
    // only because nothing here is emitted — Vite does its own resolution.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // `.cdm` holds the module augmentations `cdm install` generates — they are
  // what makes `getContract("@dw3labs/rainbow-leaderboard")` typed rather than
  // an indexed `unknown`. Left out of `include`, the files exist and do nothing:
  // every call still compiles, against `Contract<ContractDef>`, whose methods
  // index to `unknown`.
  //
  // Spelled as a glob rather than as `".cdm"`, which does not work. Expanding a
  // bare directory is a wildcard match, and TypeScript's wildcards skip anything
  // beginning with a dot — so the whole directory was silently invisible and the
  // only symptom was the untyped overload quietly winning.
  "include": ["src", ".cdm/**/*.d.ts"]
}
