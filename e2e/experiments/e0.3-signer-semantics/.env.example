# Copy to `.env` (which is gitignored) and fill in.
#
# The account must hold cACU on Acurast Canary. Free from https://faucet.acurast.com
# The CLI loads this via dotenv automatically.

ACURAST_MNEMONIC="word word word ... twelve or twenty-four words"

# Optional. If set, the deployment POSTs progress breadcrumbs here — which is
# how the Cloudflare quick-tunnel hostname gets back to us, since it is random
# per run. Leave unset to rely on `acurast devtools <id>` for stdout instead.
WEBHOOK_URL=""
